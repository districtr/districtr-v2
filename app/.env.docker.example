NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_S3_BUCKET_URL=https://fill-me.s3.amazonaws.com
NEXT_PUBLIC_S3_BUCKET_URL_MIRROR1=https://fill-me.s3.amazonaws.com
NEXT_PUBLIC_S3_BUCKET_URL_MIRROR2=https://fill-me.s3.amazonaws.com
NEXT_SERVER_API_URL=http://backend:8000

#Auth0
AUTH0_CLIENT_ID='fill-me'
AUTH0_CLIENT_SECRET='fill-me'
AUTH0_DOMAIN=fill-me.us.auth0.com # just the domain, without https://
AUTH0_ISSUER=https://fill-me.us.auth0.com/ # full url with https://
AUTH0_AUDIENCE=http://localhost:8000/
APP_BASE_URL=http://localhost:3000
AUTH0_ALGORITHMS=RS256
AUTH0_SECRET="fill-me" # Added by `npx auth`. Read more: https://cli.authjs.dev

# Feedback form
NEXT_PUBLIC_FEEDBACK_FORM="fill-me-optionally"

# Cloudflare Turnstile. The values below are Cloudflare's public dummy keys
# (always pass); swap in real widget site keys to test actual challenges, or
# use 3x00000000000000000000FF to force the interactive session fallback.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
NEXT_PUBLIC_TURNSTILE_SESSION_SITE_KEY="1x00000000000000000000AA"

# MapTiler API key for Streets/Satellite basemaps and geocoding search (optional)
NEXT_PUBLIC_MAPTILER_API_KEY="fill-me-optionally"